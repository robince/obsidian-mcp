# Required: absolute path to your Obsidian vault
VAULT_PATH=/path/to/your/vault

# Set to true to disable all write operations
# Safe network-oriented default. Set false only with a narrow WRITE_PATHS, or
# explicitly accept unrestricted compatibility behavior when WRITE_PATHS is empty.
READ_ONLY=true

# Comma-separated relative paths where writes are allowed (empty = everywhere
# only when READ_ONLY=false). A trailing slash means directory descendants;
# no trailing slash means the exact path only.
WRITE_PATHS=AI-Memory/,AI-Output/

# Paths that no MCP operation may read. These are security boundaries, unlike
# EXCLUDE_PATHS. A directory entry also denies all descendants.
DENY_READ_PATHS=.obsidian/,.trash/

# Paths that cannot be written, even when beneath WRITE_PATHS.
DENY_WRITE_PATHS=.obsidian/,.trash/,_AI_INSTRUCTIONS.md

# Use a case-sensitive filesystem for authoritative path scopes. Deny rules
# are case-folded defensively for common local case-insensitive filesystems.

# Permanent deletion is disabled unless explicitly opted in.
ALLOW_PERMANENT_DELETE=false

# Maximum size accepted for MCP and HTTP attachment writes (default 25 MiB).
MAX_ATTACHMENT_BYTES=26214400

# Lock files are kept outside the synced vault. Native default:
# <system-temp>/obsidian-mcp-locks. Docker explicitly uses /data/locks;
# set LOCK_PATH for another deployment. A configured lock-path creation
# failure is fatal rather than falling back into the vault.
# LOCK_PATH=/data/locks

# Comma-separated paths to exclude from listing/search/indexing (not access control)
EXCLUDE_PATHS=private,.obsidian,.trash

# Optional plugin-format tool groups — each disabled by default (opt-in).
# Disabled tools aren't just refused at call time, they're never registered,
# so they don't appear in a connected client's tool list at all.
# ENABLE_CANVAS=true      # .canvas file tools
# ENABLE_EXCALIDRAW=true  # *.excalidraw.md file tools
# ENABLE_KANBAN=true      # Kanban board tools
# ENABLE_BASES=true       # .base file tools (Obsidian core plugin, 1.9.0+)

# High-impact mutation tools are absent from the MCP tool list by default.
# ENABLE_MOVE=true
# ENABLE_FOLDER_RENAME=true
# ENABLE_FOLDER_RESTORE=true  # transactional multi-file restore operation
# ENABLE_BULK_REPLACE=true
# ENABLE_DELETE=true

# Transport mode: "stdio" (default, local use), "http" (recommended for
# network use), or "sse" (legacy).
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Hardened home-server Compose profile only. Prepare the nested writable paths
# inside HOST_VAULT_PATH and make MCP_DATA_PATH writable by PUID:PGID.
# HOST_VAULT_PATH=/srv/obsidian-vault
# AI_MEMORY_PATH=AI-Memory
# AI_OUTPUT_PATH=AI-Output
# MCP_DATA_PATH=/srv/obsidian-mcp-data
# PUID=1000
# PGID=1000
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:<reviewed-digest>

# API key for network transports (HTTP/SSE). It is required whenever the
# transport is not stdio unless the app's own OAuth is configured. Cloudflare
# Access Managed OAuth is an outer gate and does not inject this origin
# credential. Keep this set even when Access protects the tunnel unless the
# application OAuth verifier is intentionally your origin authentication.
# Generate with: openssl rand -hex 32
API_KEY=

# Public URL for the externally reachable server, with no trailing slash. It
# is used for OAuth callbacks and for ready-to-use attachment token URLs.
PUBLIC_BASE_URL=

# Optional app-managed GitHub OAuth, independent of API_KEY. This is useful
# for clients that only support OAuth (for example a hosted MCP connector).
# GitHub Developer Settings -> OAuth Apps:
#   Homepage URL: <PUBLIC_BASE_URL>
#   Authorization callback URL: <PUBLIC_BASE_URL>/auth/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# As soon as OAuth is configured, provide at least one allowed login. There is
# no allow-everyone fallback.
# OAUTH_GITHUB_ALLOWED_LOGINS=your-github-username
# Persist OAuth client registrations/tokens outside the vault across restarts.
# FASTMCP_HOME=/data/fastmcp

# Phase 3 sync-safe write policy. Both Compose profiles use these secure
# defaults. Native installs can normally omit the two /data paths: they then
# use namespaced state below LOCK_PATH, while the home-server Compose example
# supplies persistent paths outside the synced vault.
REQUIRE_WRITE_PRECONDITIONS=true
ALLOW_BLIND_CREATE=true
ALLOW_BLIND_OVERWRITE=false
# OPERATION_LEDGER_PATH=/data/operations.sqlite3
OPERATION_RETENTION_SECONDS=604800
# CONFLICT_PATH=/data/conflicts
STORE_CONFLICT_CONTENT=false
INDEX_RECONCILE_INTERVAL=300
WATCHER_DEBOUNCE_MS=100
WATCHER_MAX_PENDING_EVENTS=10000

# See docker-compose.home-server.yml for the complete home-server variable
# set; do not place its /data state directory inside the synced vault.
